      return Array.from(document.scripts).some(script => {
        const source = (
          (script.src || "") + " " +
          (script.id || "") + " " +
          (script.className || "") + " " +
          (script.getAttribute("data-locker") || "")
        ).toLowerCase();

        return source.includes("ogads") ||
          source.includes("content-locker") ||
          source.includes("contentlocker") ||
          source.includes("offer-locker") ||
          source.includes("offerlocker");
      });
    }

    function invokeLocker() {
      if (typeof window.call_locker === "function") {
        window.call_locker();
        return true;
      }

      const possibleFunctions = [
        "openLocker",
        "showLocker",
        "openContentLocker",
        "showContentLocker"
      ];

      for (const functionName of possibleFunctions) {
        if (typeof window[functionName] === "function") {
          window[functionName]();
          return true;
        }
      }

      return false;
    }

    function runFallback() {
      buttons.forEach(({button, countdown}) => {
        button.disabled = true;
        button.textContent = "Validating secure connection...";
        countdown.textContent = "Secure fallback begins in 3 seconds";
      });

      let remaining = 3;

      const timer = setInterval(() => {
        remaining -= 1;

        if (remaining > 0) {
          buttons.forEach(({countdown}) => {
            countdown.textContent =
              `Secure fallback begins in ${remaining} seconds`;
          });
          return;
        }

        clearInterval(timer);

        buttons.forEach(({countdown}) => {
          countdown.textContent = "Connection validated. Redirecting...";
        });

        window.location.href = FALLBACK_URL;
      }, 1000);
    }

    buttons.forEach(({button}) => {
      button.addEventListener("click", event => {
        event.preventDefault();

        if (dispatching) return;
        dispatching = true;

        if (lockerIsPresent()) {
          buttons.forEach(({button: currentButton, countdown: currentCountdown}) => {
            currentButton.textContent = "Opening secure access...";
            currentCountdown.textContent = "";
          });

          const invoked = invokeLocker();

          if (!invoked) {
            buttons.forEach(({button: currentButton}) => {
              currentButton.disabled = true;
              currentButton.textContent = "Secure access processing...";
            });
          }

          return;
        }

        runFallback();
      });
    });
  </script>
</body>
</html>
